% mysty-sp.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mysty-sp}[line spacing layout]

% This is the package for making line spacing document.
% API should be used in preamble.
%
% API (preamble):
%   - \SPFontSize{14pt}
%   - \SPKeepSmallFontNormal
%   - \SPGeometry{top=15truemm,bottom=5truemm,left=15truemm,right=15truemm}
%   - \SPFooterDate{date}
%   - \SPFooterAuthor{author}
%   - \SPFooterLabel{label}
%   - \SPFooterVersion{ver}
%   - \SPFootskip{10truemm}
%   - \SPLineStretch{5.0}
%
% API (in doc):
%   - \SPFloatBreak[htbp]{figure}

\RequirePackage{mysty-common}

\ifdefined\SP
  \RequirePackage{fancyhdr}
  \RequirePackage[dvipdfmx,truedimen]{geometry}
  \RequirePackage{setspace}
  \RequirePackage{caption}
\fi


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% FontSize
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
% internal state
\def\sp@fontsize@base{}
\newif\ifsp@fontsize@keep@small
\sp@fontsize@keep@smallfalse

%API
\newcommand{\SPFontSize}[1]{
  \def\sp@fontsize@base{#1}
}
\newcommand{\SPKeepSmallFontNormal}{
  \sp@fontsize@keep@smalltrue
}

% apply
\newcommand{\sp@fontsize@apply}{
  \ifsp@fontsize@keep@small
    \MCKeepSmallFontNormal
  \fi

  \ifx\sp@fontsize@base\@empty
    % do nothing
  \else
    \MCFontSize{\sp@fontsize@base}
  \fi

  \mc@fontsize@apply
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Geometry
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
% internal state
\def\sp@geometry@option{top=15truemm,bottom=5truemm,left=15truemm,right=15truemm}

% API
\newcommand{\SPGeometry}[1]{
 \def\sp@geometry@option{#1}
}

% apply
\newcommand{\sp@geometry@apply}{
  \edef\sp@geometry@tmp{
    includefoot,
    footskip=\sp@footskip,
    \sp@geometry@option
  }
  \expandafter\geometry\expandafter{\sp@geometry@tmp}
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% fancyhdr / footer
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\newcommand{\sp@twodigits}[1]{\ifnum#1<10 0\fi\number#1}

% internal state
\def\sp@footer@date{\number\year/\sp@twodigits{\month}/\sp@twodigits{\day}}
\def\sp@footer@author{}
\def\sp@footer@label{}
\def\sp@footer@version{-}
\def\sp@footskip{10truemm}

\@ifundefined{SP}{}{\def\sp@footer@version{\SP}}

% API
\newcommand{\SPFooterDate}[1]{\def\sp@footer@date{#1}}
\newcommand{\SPFooterAuthor}[1]{\def\sp@footer@author{#1}}
\newcommand{\SPFooterLabel}[1]{\def\sp@footer@label{#1}}
\newcommand{\SPFooterVersion}[1]{\def\sp@footer@version{#1}}
\newcommand{\SPFootskip}[1]{\def\sp@footskip{#1}}

% apply
\newcommand{\sp@fancyhdr@setpagestyle}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0.4pt}
  \fancyfoot[C]{%
    \sp@footer@date\quad
    \sp@footer@author\quad
    \sp@footer@label\quad
    ver.\sp@footer@version\quad
    p.\thepage
  }
}
\newcommand{\sp@fancyhdr@apply}{
  \pagestyle{fancy}
  \sp@fancyhdr@setpagestyle
  \thispagestyle{fancy}

  \fancypagestyle{plain}{\sp@fancyhdr@setpagestyle}
  %\fancypagestyle{empty}{\sp@fancyhdr@setpagestyle}
}

\AddToHook{cmd/maketitle/after}{
  \ifdefined\SP
    \pagestyle{fancy}
    \thispagestyle{fancy}
  \fi
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Line spacing
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
% internal state
\def\sp@line@stretch{5.0}

% API
\newcommand{\SPLineStretch}[1]{
  \def\sp@line@stretch{#1}
}

% apply
\newcommand{\sp@line@apply}{
 \setstretch{\sp@line@stretch}
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% MAIN
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\newcommand{\sp@applyall}{
  \sp@fontsize@apply
  \sp@geometry@apply
  \sp@fancyhdr@apply
  \sp@line@apply
}
\makeatother


\makeatletter
\AddToHook{begindocument/before}{
  \ifdefined\SP
    \sp@applyall
  \fi
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Float Helper
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% API
\makeatletter
\newcommand{\SPFloatBreak}[2][htbp]{
  \ifdefined\SP
    \expandafter\end\expandafter{#2}
    \expandafter\begin\expandafter{#2}[#1]
      \ContinuedFloat
      \centering
  \fi
}
\makeatother
