% mysty-common.sty
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mysty-common}[common settings]

% This is the package that integrates common settings.
% API should be used in preamble.
%
% API (preamble):
%   - \MCFontSize{14pt}
%   - \MCKeepSmallFontNormal


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Packages
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\PassOptionsToPackage{dvipdfmx}{graphics}
\PassOptionsToPackage{dvipdfmx}{xcolor}

\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{amsmath}
%\RequirePackage{amssymb}
%\RequirePackage{amsfonts}
\RequirePackage{bm}
\RequirePackage{siunitx}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{here}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{jlisting}
\RequirePackage{subcaption}
\RequirePackage{url}
\RequirePackage{placeins}
\RequirePackage{pgffor}

\makeatletter
\@ifpackageloaded{cite}{}{\RequirePackage{cite}}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Helper
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\providecommand{\erase}[1]{\textcolor{black}{#1}}
\providecommand{\red}[1]{\textcolor{red}{#1}}
\providecommand{\blue}[1]{\textcolor{blue}{#1}}
\providecommand{\dd}{\mathrm{d}}
\providecommand{\hquad}{\hspace{0.5em}}

% table caption in minipage
\makeatletter
\providecommand{\tblcaption}{\def\@captype{table}\caption}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% siunitx
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\sisetup{
  group-separator = {,},
  group-minimum-digits = 4
}

\makeatletter
\@ifundefined{unit}{
  \newcommand{\unit}[1]{\,\si{#1}}
}{
  \renewcommand{\unit}[1]{\,\si{#1}}
}
\providecommand{\unitb}[1]{\,[\si{#1}]}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% subcaption
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\captionsetup[subfigure]{labelformat=simple}
\captionsetup[subtable]{labelformat=simple}
\renewcommand{\thesubfigure}{(\alph{subfigure})}
\renewcommand{\thesubtable}{(\alph{subtable})}

\makeatletter
\renewcommand{\p@subfigure}{\thefigure\space}
\renewcommand{\p@subtable}{\thetable\space}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% listings / jlisting
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\lstset{
  language = C,
  backgroundcolor = \color{white},
  breaklines = true,
  breakindent = 10pt,
  basicstyle = \ttfamily\scriptsize,
  commentstyle = {\ttfamily \color[cmyk]{1,0.4,1,0}},
  classoffset = 0,
  keywordstyle = {\bfseries \color[cmyk]{0,1,0,0}},
  stringstyle = {\ttfamily \color[rgb]{0,0,1}},
  frame = tb,
  framesep = 5pt,
  numbers = left,
  stepnumber = 1,
  numberstyle = \tiny,
  tabsize = 4,
  captionpos = t,
  showstringspaces = false,
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% cite
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\newif\if@mc@citeused
\@mc@citeusedfalse

\let\mc@cite@orig\cite
\renewcommand{\cite}[1]{%
  \global\@mc@citeusedtrue%
  \mc@cite@orig{#1}%
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% bibliography
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
% internal state
\def\mc@bibstyle{myjunsrt}
\def\mc@bibfile{myrefs}

% API
\newcommand{\MCBibStyle}[1]{\def\mc@bibstyle{#1}}
\newcommand{\MCBibFile}[1]{\def\mc@bibfile{#1}}

\newcommand{\MCBibPrint}{
  \if@mc@citeused
    \bibliographystyle{\mc@bibstyle}
    \bibliography{\mc@bibfile}
  \fi
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% subfiles
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\MCSubfilePostamble}{
  \clearpage
  \MCBibPrint
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Font size
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter

% internal state
\newdimen\mc@fontsize@base
\mc@fontsize@base=0pt

\newif\ifmc@fontsize@keep@small
\mc@fontsize@keep@smallfalse

% API
\newcommand{\MCFontSize}[1]{
  \mc@fontsize@base=#1\relax
}

\newcommand{\MCKeepSmallFontNormal}{
  \mc@fontsize@keep@smalltrue
}

% apply
\newcommand{\mc@fontsize@scaled}[1]{
  \strip@pt\dimexpr #1\mc@fontsize@base/10\relax pt
}
\newcommand{\mc@definefontsize}[3]{
  \renewcommand#1{
    \@setfontsize#1{\mc@fontsize@scaled{#2}}{\mc@fontsize@scaled{#3}}
  }
}
\newcommand{\mc@fontsize@apply}{
  \ifdim\mc@fontsize@base=0pt
    % do nothing
  \else
    \mc@definefontsize{\normalsize}{10}{12}
    \mc@definefontsize{\large}{12}{14}
    \mc@definefontsize{\Large}{14.4}{18}
    \mc@definefontsize{\LARGE}{17.28}{22}
    \mc@definefontsize{\huge}{20.74}{25}
    \mc@definefontsize{\Huge}{24.88}{30}

    \ifmc@fontsize@keep@small
      \renewcommand\small{\normalsize}
      \renewcommand\footnotesize{\normalsize}
      \renewcommand\scriptsize{\normalsize}
      \renewcommand\tiny{\normalsize}
    \else
      \mc@definefontsize{\small}{9}{11}
      \mc@definefontsize{\footnotesize}{8}{9.5}
      \mc@definefontsize{\scriptsize}{7}{8}
      \mc@definefontsize{\tiny}{5}{6}
    \fi

    \normalsize

    \DeclareMathSizes
      {\strip@pt\mc@fontsize@base}
      {\strip@pt\mc@fontsize@base}
      {\strip@pt\dimexpr 0.7\mc@fontsize@base\relax}
      {\strip@pt\dimexpr 0.5\mc@fontsize@base\relax}
  \fi
}
\makeatother


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% MAIN
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\makeatletter
\AtBeginDocument{
  \mc@fontsize@apply
}
\makeatother
